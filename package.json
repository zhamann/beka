{
  "name": "beka",
  "description": "A self-hosted app that shows a household's current financial picture: paychecks, spending, recurring payments, accounts, loans, and cards.",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "check:lockfile": "bun tools/check-lockfile.mjs",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.52.0",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.11.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhamann/beka.git"
  },
  "homepage": "https://github.com/zhamann/beka#readme",
  "bugs": {
    "url": "https://github.com/zhamann/beka/issues"
  }
}
