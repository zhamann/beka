{
  "name": "beka",
  "description": "A self-hosted app that shows a household's current financial picture: paychecks, spending, recurring payments, accounts, loans, and cards.",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7",
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.51.0",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhamann/beka.git"
  },
  "homepage": "https://github.com/zhamann/beka#readme",
  "bugs": {
    "url": "https://github.com/zhamann/beka/issues"
  }
}
