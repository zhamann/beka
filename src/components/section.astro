---
interface Props {
  title: string
  description?: string
  id?: string
}

const { title, description, id } = Astro.props
---

<section id={id} class="flex scroll-mt-32 flex-col gap-4">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div class="flex max-w-prose flex-col gap-1">
      <h2 class="font-heading text-2xl/tight">{title}</h2>
      {description && (
        <p class="text-sm/relaxed text-muted-foreground">{description}</p>
      )}
    </div>
    <div class="flex flex-wrap gap-2">
      <slot name="actions" />
    </div>
  </div>
  <slot />
</section>
