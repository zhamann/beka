---
import { CategorySettings } from "@/components/category-settings"
import PageHeader from "@/components/page-header.astro"
import { RewardCategories } from "@/components/reward-categories"
import Section from "@/components/section.astro"
import AppLayout from "@/layouts/app.astro"
import { listCards, listRewardCategories } from "@/server/cards"
import { listCategories } from "@/server/categories"
import { getDatabase } from "@/server/database"

const db = getDatabase()
const earnedBy: Record<number, string[]> = {}
for (const card of listCards(db)) {
  for (const bonus of card.bonuses) {
    const names = (earnedBy[bonus.rewardCategoryId] ??= [])
    if (!names.includes(card.name)) names.push(card.name)
  }
}
---

<AppLayout
  title="Categories"
  breadcrumb={[
    { label: "Settings", href: "/settings" },
    { label: "Categories" },
  ]}
>
  <PageHeader
    title="Categories"
    description="How transactions are sorted, and what card bonuses are earned on."
  />
  <Section
    title="Transaction categories"
    description="Categories for transactions. The type decides where they count."
  >
    <CategorySettings client:load categories={listCategories(db)} />
  </Section>
  <Section
    title="Reward categories"
    description="What card bonuses are earned on. Everything else earns each card's base rate."
  >
    <RewardCategories
      client:load
      categories={listRewardCategories(db)}
      earnedBy={earnedBy}
    />
  </Section>
</AppLayout>
