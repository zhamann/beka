---
import {
  IconCheck,
  IconChevronRight,
  IconEqual,
  IconTrendingDown,
  IconTrendingUp,
} from "@tabler/icons-react"
import { cn } from "cn"

import Flow from "@/components/flow.astro"
import { PaceChart } from "@/components/pace-chart"
import PageHeader from "@/components/page-header.astro"
import Section from "@/components/section.astro"
import Statement from "@/components/statement.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { ACCOUNT_GROUPS } from "@/lib/accounts"
import { categoryFill } from "@/lib/categories"
import AppLayout from "@/layouts/app.astro"
import { formatShortDate, today } from "@/lib/dates"
import { formatMoney } from "@/lib/money"
import { formatMonth } from "@/lib/months"
import { listAccounts } from "@/server/accounts"
import { dashboard } from "@/server/dashboard"
import type { Reminder } from "@/server/freshness"
import { getDatabase } from "@/server/database"
import { listMembers } from "@/server/household"
import { listRecurring } from "@/server/recurring"
import {
  firstTransactionMonth,
  shiftMonth,
  spendingPace,
  spendingTable,
} from "@/server/spending"

const db = getDatabase()
const on = today()
const data = dashboard(db, on)
const hasMembers = listMembers(db).length > 0
const started =
  hasMembers && (data.income > 0 || data.spend > 0 || data.netWorth.assets > 0)
const payments = listRecurring(db, { on }).length
const steps = [
  {
    label: "Add the people in your household",
    detail: "Income and accounts belong to someone.",
    href: "/settings#household",
    action: "Add people",
    done: hasMembers,
  },
  {
    label: "Add income",
    detail: "Each job's pay, or other income like a pension.",
    href: "/income",
    action: "Add income",
    done: data.income > 0,
  },
  {
    label: "Add accounts",
    detail: "Checking, savings, investments, and property.",
    href: "/accounts",
    action: "Add accounts",
    done: listAccounts(db).length > 0,
  },
  {
    label: "Import transactions",
    detail: "A month or more from your bank and cards.",
    href: "/import",
    action: "Import",
    done: firstTransactionMonth(db) !== null,
  },
]
const nextStep = steps.find((step) => !step.done)
const share = (cents: number) =>
  data.income > 0 ? `${Math.round((cents / data.income) * 100)}%` : null

// This month's spending against each category's average, recurring left out
// like the Dashboard's Spend.
const thisMonth = on.slice(0, 7)
const lastComplete = shiftMonth(thisMonth, -1)
const first = firstTransactionMonth(db)
const windowStart = shiftMonth(lastComplete, -11)
const month = spendingTable(db, {
  from: first && first > windowStart ? first : windowStart,
  to: thisMonth,
  on,
})
const paceData = spendingPace(db, on)
const pace = paceData.day / paceData.days
const spentSoFar = (byMonth: Record<string, number>) => byMonth[thisMonth] ?? 0
const ranked = [...month.categories].sort(
  (a, b) =>
    Math.max(b.average, spentSoFar(b.byMonth)) -
    Math.max(a.average, spentSoFar(a.byMonth))
)
const top = ranked.slice(0, 6)
const rest = ranked.slice(6)
const rows = [
  ...top.map((c) => ({
    name: c.name,
    fill: categoryFill(c.color),
    href: `/transactions?category=${c.id}&month=${thisMonth}&recurring=exclude`,
    spent: spentSoFar(c.byMonth),
    average: c.average,
  })),
  ...(rest.length
    ? [
        {
          name: "Everything else",
          fill: "bg-muted-foreground",
          href: `/transactions?categories=${rest.map((c) => c.id).join(",")}&month=${thisMonth}&recurring=exclude`,
          spent: rest.reduce((sum, c) => sum + spentSoFar(c.byMonth), 0),
          average: rest.reduce((sum, c) => sum + c.average, 0),
        },
      ]
    : []),
]
const totalSpent = month.totals[thisMonth] ?? 0
const fill = (spent: number, average: number) =>
  average > 0 ? Math.min(spent / average, 1) : spent > 0 ? 1 : 0
const whole = (cents: number) => formatMoney(cents, { whole: true })
/** Where a category stands against its average and an even pace for today. */
const standing = (spent: number, average: number) =>
  average <= 0
    ? "ok"
    : spent > average
      ? "over"
      : spent > average * pace
        ? "ahead"
        : "ok"
const STANDING_LABEL = {
  over: "Over average",
  ahead: "Spending faster than usual",
  ok: "",
}
// How far under or over a usual month's pace today's total is.
const usualByNow = paceData.usual[paceData.day - 1]
const gap = usualByNow === undefined ? null : usualByNow - totalSpent
const paceNote = (spent: number, average: number) =>
  average <= 0
    ? ""
    : spent > average
      ? ", over the average"
      : spent > average * pace
        ? ", spending faster than usual"
        : ", within an even pace"

/** What each reminder's link does. */
const ACTION: Record<Reminder["kind"], string> = {
  balance: "Update balance",
  transactions: "Import",
  uncategorized: "Categorize",
  "recurring-suggestions": "Review",
  "recurring-overdue": "Review",
  "rotating-categories": "Add categories",
  "tax-tables": "Details",
}
---

<AppLayout title="Dashboard">
  <PageHeader
    title={started ? formatMonth(thisMonth, "long") : "Dashboard"}
    description={
      started
        ? `Day ${paceData.day} of ${paceData.days}. This month's spending so far, then what a typical month looks like.`
        : "What you've spent this month, what a typical month looks like, and what you hold."
    }
  />
  {nextStep && (
    <Section
      title="Set up your household"
      description="Four steps, in this order. The Dashboard fills in as you go."
    >
      <ol class="flex flex-col divide-y rounded-xl border bg-card">
        {steps.map((step, index) => (
          <li class="flex items-center gap-4 px-4 py-3 @2xl:px-5">
            <span
              class:list={[
                "flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-medium",
                step.done
                  ? "bg-primary text-primary-foreground"
                  : "bg-muted text-muted-foreground",
              ]}
            >
              {step.done ? (
                <IconCheck className="size-4" aria-hidden="true" />
              ) : (
                index + 1
              )}
            </span>
            <span class="flex flex-1 flex-col">
              <span class:list={["font-medium", step.done && "line-through"]}>
                {step.label}
              </span>
              <span class="text-sm text-muted-foreground">
                {step.done ? "Done" : step.detail}
              </span>
            </span>
            {!step.done && (
              <a
                href={step.href}
                class={cn(
                  buttonVariants({
                    variant: step === nextStep ? "default" : "outline",
                    size: "sm",
                  })
                )}
              >
                {step.action}
              </a>
            )}
          </li>
        ))}
      </ol>
    </Section>
  )}
  {started && (
    <div class="flex flex-col gap-4 md:gap-6">
      <Card>
        <CardContent className="flex flex-col gap-6">
          <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
            <div class="flex flex-col gap-1">
              <h2 class="text-base font-medium text-muted-foreground">
                Spent so far
              </h2>
              <a
                href={`/transactions?month=${thisMonth}&recurring=exclude`}
                class="self-start font-heading text-6xl/none tabular-nums hover:underline md:text-7xl/none"
              >
                {whole(totalSpent)}
              </a>
              <p class="text-base text-muted-foreground">
                {paceData.months > 0
                  ? `of a usual ${whole(month.average)}, recurring payments left out`
                  : "recurring payments left out"}
              </p>
            </div>
            {gap !== null && (
              <Badge
                variant={gap < 0 ? "destructive" : "outline"}
                className="gap-1.5 bg-card py-1"
              >
                {gap > 0 ? (
                  <IconTrendingDown
                    className="text-income"
                    aria-hidden="true"
                  />
                ) : gap < 0 ? (
                  <IconTrendingUp aria-hidden="true" />
                ) : (
                  <IconEqual aria-hidden="true" />
                )}
                {gap === 0
                  ? "Right on your usual pace"
                  : `${whole(Math.abs(gap))} ${gap > 0 ? "under" : "over"} your usual pace`}
              </Badge>
            )}
          </div>
          <PaceChart
            client:load
            month={paceData.month}
            day={paceData.day}
            days={paceData.days}
            spent={paceData.spent}
            usual={paceData.usual}
          />
        </CardContent>
      </Card>
      <div class="grid items-start gap-4 md:gap-6 @4xl:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle className="text-lg">Where it's gone</CardTitle>
            <CardDescription>
              Each category so far against its monthly average. The tick marks
              an even pace for today.
            </CardDescription>
          </CardHeader>
          <CardContent>
            {rows.length === 0 ? (
              <p class="text-sm text-muted-foreground">
                Import transactions to compare this month with your averages.
              </p>
            ) : (
              <ul class="-my-3 flex flex-col divide-y">
                {rows.map((row) => (
                  <li>
                    <a
                      href={row.href}
                      class="group grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-2.5 py-4 text-base"
                    >
                      <span>
                        <span
                          class:list={[
                            "mr-2.5 inline-block size-2.5 rounded-full",
                            row.fill,
                          ]}
                          aria-hidden="true"
                        />
                        <span class="font-medium group-hover:underline">
                          {row.name}
                        </span>
                        {standing(row.spent, row.average) !== "ok" && (
                          <Badge
                            variant={
                              standing(row.spent, row.average) === "over"
                                ? "destructive"
                                : "outline"
                            }
                            className="ml-2 align-middle"
                            aria-hidden="true"
                          >
                            {STANDING_LABEL[standing(row.spent, row.average)]}
                          </Badge>
                        )}
                      </span>
                      <span class="tabular-nums" aria-hidden="true">
                        <span
                          class:list={[
                            "font-medium",
                            row.spent > row.average && "text-destructive",
                          ]}
                        >
                          {whole(row.spent)}
                        </span>
                        <span class="text-sm text-muted-foreground">
                          {" "}
                          of {whole(row.average)}
                        </span>
                      </span>
                      <span class="sr-only">
                        {`${whole(row.spent)} of a ${whole(row.average)} average${paceNote(row.spent, row.average)}`}
                      </span>
                      <span
                        class="relative col-span-2 h-2 rounded-full bg-muted"
                        aria-hidden="true"
                      >
                        <span
                          class:list={[
                            "absolute inset-y-0 left-0 rounded-full",
                            row.fill,
                          ]}
                          style={{
                            width: `${(fill(row.spent, row.average) * 100).toFixed(1)}%`,
                          }}
                        />
                        <span
                          class="absolute -inset-y-1 w-0.5 rounded-full bg-foreground/70"
                          style={{ left: `${(pace * 100).toFixed(1)}%` }}
                        />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </CardContent>
        </Card>
        <div class="flex flex-col gap-4 md:gap-6">
          {data.reminders.length > 0 && (
            <Card>
              <CardHeader>
                <CardTitle className="text-lg">Needs updating</CardTitle>
                <CardDescription>
                  What to refresh so these numbers stay right.
                </CardDescription>
                <CardAction>
                  <a
                    href="/settings#reminders"
                    class={cn(
                      buttonVariants({ variant: "outline", size: "sm" })
                    )}
                  >
                    Settings
                  </a>
                </CardAction>
              </CardHeader>
              <CardContent>
                <ul class="-my-3 flex flex-col divide-y text-base">
                  {data.reminders.slice(0, 3).map((reminder) => (
                    <li>
                      <a
                        href={reminder.href}
                        class="group flex items-center justify-between gap-4 py-3"
                      >
                        {reminder.message}
                        <span class="flex shrink-0 items-center gap-0.5 text-sm font-medium group-hover:underline">
                          {ACTION[reminder.kind]}
                          <IconChevronRight
                            className="size-4"
                            aria-hidden="true"
                          />
                        </span>
                      </a>
                    </li>
                  ))}
                  {data.reminders.length > 3 && (
                    <li>
                      <details class="group/more">
                        <summary class="flex cursor-pointer list-none items-center gap-2 py-3 text-sm font-medium text-muted-foreground [&::-webkit-details-marker]:hidden">
                          <IconChevronRight
                            className="size-4 transition-transform group-open/more:rotate-90"
                            aria-hidden="true"
                          />
                          <span class="group-open/more:hidden">
                            Show {data.reminders.length - 3} more
                          </span>
                          <span class="hidden group-open/more:inline">
                            Show fewer
                          </span>
                        </summary>
                        <ul class="flex flex-col divide-y border-t">
                          {data.reminders.slice(3).map((reminder) => (
                            <li>
                              <a
                                href={reminder.href}
                                class="group flex items-center justify-between gap-4 py-3"
                              >
                                {reminder.message}
                                <span class="flex shrink-0 items-center gap-0.5 text-sm font-medium group-hover:underline">
                                  {ACTION[reminder.kind]}
                                  <IconChevronRight
                                    className="size-4"
                                    aria-hidden="true"
                                  />
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  )}
                </ul>
              </CardContent>
            </Card>
          )}
          <Card>
            <CardHeader>
              <CardTitle className="text-lg">Coming up</CardTitle>
              <CardDescription>
                Paychecks and recurring charges in the next 14 days.
              </CardDescription>
            </CardHeader>
            <CardContent>
              {data.comingUp.length === 0 ? (
                <p class="text-sm text-muted-foreground">Nothing expected.</p>
              ) : (
                <ul class="-my-3 flex flex-col divide-y text-base">
                  {data.comingUp.map((item) => (
                    <li class="grid grid-cols-[3.5rem_1fr_auto] items-baseline gap-x-3 py-3">
                      <span class="text-sm text-muted-foreground tabular-nums">
                        {formatShortDate(item.date)}
                      </span>
                      <a
                        href={
                          item.kind === "deposit"
                            ? `/income/deposits#month-${item.date.slice(0, 7)}`
                            : "/recurring"
                        }
                        class="hover:underline"
                      >
                        {item.name}
                      </a>
                      <span
                        class:list={[
                          "whitespace-nowrap tabular-nums",
                          item.amount > 0 && "font-medium text-income",
                        ]}
                      >
                        {formatMoney(item.amount)}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">Where a typical month goes</CardTitle>
          <CardDescription>
            Income is take-home pay with bonuses averaged in, and spending is
            your average, so this isn't this month's cash.
          </CardDescription>
        </CardHeader>
        <CardContent className="text-base">
          {data.income > 0 ? (
            <Flow
              label="A typical month"
              income={data.income}
              incomeHref="/income"
              sources={data.incomeSources.map((source) => ({
                label: source.name,
                detail: source.memberName,
                amount: source.monthly,
              }))}
              parts={[
                {
                  label: "Recurring",
                  amount: data.recurring,
                  detail: [
                    `${payments} payment${payments === 1 ? "" : "s"}`,
                    share(data.recurring) &&
                      `${share(data.recurring)} of income`,
                  ]
                    .filter(Boolean)
                    .join(", "),
                  share: share(data.recurring) ?? undefined,
                  href: "/recurring",
                  tone: "recurring",
                },
                {
                  label: "Spending",
                  amount: data.spend,
                  detail: [
                    `average of ${data.spendMonths} month${data.spendMonths === 1 ? "" : "s"}`,
                    share(data.spend) && `${share(data.spend)} of income`,
                  ]
                    .filter(Boolean)
                    .join(", "),
                  share: share(data.spend) ?? undefined,
                  href: "/spending",
                  tone: "spending",
                },
                {
                  label: "Left over",
                  amount: data.net,
                  // Until spending is imported, what's "left" is only income
                  // minus recurring, so say so rather than show a too-rosy share.
                  detail:
                    data.spendMonths === 0
                      ? "before spending, which isn't imported yet"
                      : (share(data.net) ?? undefined) &&
                        `${share(data.net)} of income`,
                  share:
                    data.spendMonths === 0
                      ? undefined
                      : (share(data.net) ?? undefined),
                  tone: "left-over",
                },
              ]}
            />
          ) : (
            <Statement
              label="A typical month"
              terms={[
                {
                  label: "Income",
                  value: formatMoney(data.income),
                  href: "/income",
                },
                {
                  op: "−",
                  label: "Recurring",
                  value: formatMoney(data.recurring),
                  href: "/recurring",
                },
                {
                  op: "−",
                  label: "Spending",
                  value: formatMoney(data.spend),
                  href: "/spending",
                },
                { op: "=", label: "Short", value: formatMoney(data.net) },
              ]}
            />
          )}
          {data.income > 0 && data.net < 0 && (
            <p class="pt-4 font-medium text-destructive">
              Short {formatMoney(-data.net)} a month: recurring payments and
              spending come to more than income.
            </p>
          )}
        </CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">Net worth</CardTitle>
          <CardDescription>Each open account's latest balance.</CardDescription>
          <CardAction>
            <a
              href="/accounts"
              class={cn(buttonVariants({ variant: "outline", size: "sm" }))}
            >
              Accounts
            </a>
          </CardAction>
        </CardHeader>
        <CardContent className="text-base">
          <Statement
            label="Net worth"
            terms={[
              { label: "Assets", value: formatMoney(data.netWorth.assets) },
              {
                op: "−",
                label: "Debts",
                value: formatMoney(data.netWorth.debts),
              },
              {
                op: "=",
                label: "Net worth",
                value: formatMoney(data.netWorth.net),
              },
            ]}
            legend
            parts={ACCOUNT_GROUPS.map((group, index) => ({
              label: group.title,
              amount: group.kinds.reduce(
                (sum, kind) => sum + (data.netWorth.byKind[kind] ?? 0),
                0
              ),
              tone: (index + 1) as 1 | 2 | 3,
            }))}
          />
        </CardContent>
      </Card>
    </div>
  )}
</AppLayout>
